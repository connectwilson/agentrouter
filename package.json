{
  "name": "agentrouter",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "adn": "./bin/adn.js",
    "agentrouter": "./bin/agentrouter.js",
    "agent-router": "./bin/agent-router.js",
    "agent-router-mcp": "./bin/agent-router-mcp.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "PORT=8800 node src/server.js",
    "demo": "node src/demo.js",
    "test": "node --test",
    "test:mvp": "node --test",
    "provider:import": "node scripts/import-provider-docs.js",
    "provider:sync": "node scripts/sync-provider-configs.js",
    "catalog:sync": "node scripts/public-api-pipeline.js sync",
    "catalog:run": "node scripts/public-api-pipeline.js run",
    "catalog:retry": "node scripts/public-api-pipeline.js retry",
    "catalog:coverage": "node scripts/public-api-pipeline.js coverage",
    "monitor:binance:futures-delists": "node scripts/monitor-binance-futures-delists.js",
    "router:ask": "node bin/agent-router.js ask",
    "audit:payments": "node scripts/payment-audit.js",
    "canary:settlement": "node scripts/live-settlement-canary.js",
    "mcpb:check": "node --check mcpb/agentrouter/server/index.js",
    "mcpb:pack": "mcpb pack mcpb/agentrouter",
    "mcp:npm:check": "node --check packages/agentrouter-mcp/server/index.js",
    "mcp:npm:pack": "npm pack ./packages/agentrouter-mcp --dry-run",
    "mcp-package-smoke": "node scripts/mcp-package-smoke.js",
    "plugin:skill:sync": "node scripts/sync-plugin-skill.js",
    "dev:local": "node --env-file=.env.local src/server.js",
    "anchor:deploy": "node scripts/deploy-evidence-anchor.js"
  },
  "dependencies": {
    "@x402/core": "^2.12.0",
    "@x402/evm": "^2.12.0",
    "@x402/fetch": "^2.12.0",
    "pg": "^8.21.0",
    "qrcode-svg": "^1.1.0",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "solc": "^0.8.36"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
